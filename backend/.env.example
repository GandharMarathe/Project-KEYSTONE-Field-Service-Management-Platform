# Local development environment for the KEYSTONE backend.
# Spring Boot does not load this file automatically.
# Copy to `.env` for your own notes, or export these as environment variables.
# Never commit `.env`. It is gitignored.
# The same local-dev defaults already exist in src/main/resources/application.properties.

# Backend API (Spring Boot default)
SERVER_PORT=8080
# http://localhost:8080

# PostgreSQL
# Start the Windows service first (psql is only the SQL client):
#   Get-Service *postgres*
#   Start-Service postgresql-x64-18
# Optional: psql -h 127.0.0.1 -U postgres -d keystone
# Need database `keystone` on 127.0.0.1:5432 (CREATE DATABASE keystone; if missing).
DB_URL=jdbc:postgresql://127.0.0.1:5432/keystone
DB_USERNAME=postgres
# Local-dev only. Do not reuse in production. Do not paste into README or chat logs.
DB_PASSWORD=Keystone@2026Strong!

# JWT signing secret (local-dev only — change before any shared or production deploy)
JWT_SECRET=KEYSTONE-development-secret-key-change-this-before-production-123456789

# Related local URLs (not read by Spring Boot)
# API login: POST http://localhost:8080/api/auth/login
# Frontend is on the `frontend` branch, not in this checkout.
