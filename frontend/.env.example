VITE_API_BASE_URL=http://localhost:8080
# Local UI-only role switcher. Must be false (or unset) in production / Netlify.
VITE_ENABLE_UI_DEV_ACCESS=true

# Playwright e2e (not read by Vite). Defaults to the local Flyway manager seed if unset.
# E2E_MANAGER_EMAIL=admin@keystone.dev
# E2E_MANAGER_PASSWORD=
# E2E_FRONTEND_URL=http://localhost:5173
# E2E_API_URL=http://localhost:8080

# --- Production / Netlify (set in the host UI, do not commit real values) ---
# VITE_API_BASE_URL=https://keystone-api-xxxx.onrender.com
# VITE_ENABLE_UI_DEV_ACCESS=false
